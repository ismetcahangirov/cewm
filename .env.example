# Copy to .env and fill in. Never commit .env.
# Public variables (NEXT_PUBLIC_*) are inlined into the browser bundle at build time.

# Public origin of the site, no trailing slash. Used for canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# PostgreSQL connection string. docker-compose.yml starts a matching local database.
DATABASE_URL=postgres://cewm:cewm@localhost:5452/cewm
# Host port docker-compose publishes Postgres on; change it (and DATABASE_URL) if 5452 is taken.
POSTGRES_PORT=5452

# S3-compatible object storage for media (Hetzner Object Storage in production, RustFS from docker-compose.yml locally).
# The app streams objects through /media/<key>, so the bucket does not need to be public.
S3_ENDPOINT=http://localhost:9020
S3_REGION=eu-central
S3_BUCKET=cewm
S3_ACCESS_KEY_ID=cewm
S3_SECRET_ACCESS_KEY=cewm-secret

# Better Auth: a random string of at least 32 characters (openssl rand -base64 32) and the app origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3020

# Outgoing mail for consultation request notifications. Locally, Mailpit from docker-compose.yml
# catches everything (web UI on http://localhost:8045).
SMTP_HOST=localhost
SMTP_PORT=1045
SMTP_USER=cewm
SMTP_PASSWORD=cewm
SMTP_FROM="CEWM <no-reply@cewm.az>"
# Inbox that receives new consultation requests when the admin settings name none.
CONSULTATION_NOTIFY_EMAIL=sales@example.com
