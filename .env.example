# Copy to .env and fill in. Never commit .env.
# Public variables (NEXT_PUBLIC_*) are inlined into the browser bundle at build time.

# Public origin of the site, no trailing slash. Used for canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. docker-compose.yml starts a matching local database.
DATABASE_URL=postgres://mebline:mebline@localhost:5432/mebline
# Host port docker-compose publishes Postgres on; change it (and DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432

# Old WordPress site read by `pnpm migrate:wp` (GET requests only).
WP_ORIGIN=https://mebline.az

# S3-compatible object storage for media (Hetzner Object Storage in production, RustFS from docker-compose.yml locally).
# The app streams objects through /media/<key>, so the bucket does not need to be public.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central
S3_BUCKET=mebline
S3_ACCESS_KEY_ID=mebline
S3_SECRET_ACCESS_KEY=mebline-secret

# Better Auth: a random string of at least 32 characters (openssl rand -base64 32) and the app origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Outgoing mail for quote request notifications. Locally, Mailpit from docker-compose.yml catches everything.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mebline
SMTP_PASSWORD=mebline
SMTP_FROM="Mebline <no-reply@mebline.az>"
# Inbox that receives new quote requests.
QUOTE_NOTIFY_EMAIL=info@mebline.az
